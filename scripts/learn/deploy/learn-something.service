[Unit]
Description=Thagobyte Learn Something: write and publish today's article
Documentation=file://%h/.local/lib/learn-something/README.md
Wants=network-online.target
After=network-online.target
# Restart=on-failure below retries every 10 minutes; stop after 4 tries.
StartLimitIntervalSec=12h
StartLimitBurst=4

[Service]
Type=oneshot
Restart=on-failure
RestartSec=10min
TimeoutStartSec=15min

# Code runs from the reviewed, installed copy. The bot clone is only data
# (learn.json) and git; nothing in it is executed.
WorkingDirectory=%h/Work/thagobyte/projects/stegosoft-learn-bot
Environment=CLAUDE_BIN=%h/.local/share/mise/shims/claude
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Environment=LEARN_MODEL=sonnet
ExecStart=/usr/bin/python3 -I %h/.local/lib/learn-something/generate.py --publish --repo %h/Work/thagobyte/projects/stegosoft-learn-bot

# --- Hardening ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The bot clone, plus what claude and the mise shim write to.
ReadWritePaths=%h/Work/thagobyte/projects/stegosoft-learn-bot
ReadWritePaths=%h/.claude %h/.claude.json %h/.cache/claude-cli-nodejs
ReadWritePaths=-%h/.local/state/mise -%h/.cache/mise
InaccessiblePaths=-%h/.claude/channels -%h/.ssh -%h/.gnupg
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

# --- Push credentials: stegosoft-only deploy key (recommended) ---
# The key is bound read-only into the runtime dir; ~/.ssh itself stays
# inaccessible. The bot clone's core.sshCommand points at these paths
# (see README.md). gh's token is hidden from the job entirely.
BindReadOnlyPaths=%h/.ssh/learn_bot:%t/learn-bot/key
BindReadOnlyPaths=%h/.ssh/learn_bot_known_hosts:%t/learn-bot/known_hosts
InaccessiblePaths=-%h/.config/gh

# --- Fallback: push over https with the gh token instead ---
# Comment out the three deploy-key lines above, set the clone's remote to
# https://github.com/turkatron2099/stegosoft.git, and leave ~/.config/gh
# readable. Note this token can push to every repo the gh login can.
